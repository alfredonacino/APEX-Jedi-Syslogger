# Maintainer: Alfredo Nacino <alfredo@nacino.net>
# Arch Linux / Manjaro / EndeavourOS package.
#
# There is nothing to compile: the app is JavaScript that Node runs directly, so
# this installs the tree and a launcher. Keep pkgver in step with js/version.js —
# `packaging/version.sh --check` fails the build if it drifts.
pkgname=apex-jedisyslogger
pkgver=1.0.2
pkgrel=1
pkgdesc="SIEM log-ingestion simulator — terminal dashboard, 72 attack scenarios, 42 appliance formats"
arch=('any')
url="https://github.com/alfredonacino/APEX-Jedi-Syslogger"
# The repository declares no licence, so this cannot claim one. Add a LICENSE
# file and change this to the matching identifier before publishing the package.
license=('custom:unspecified')
depends=('nodejs>=18')
optdepends=('nginx: to reverse-proxy the optional web dashboard')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -d "$pkgdir/usr/share/$pkgname"
  cp -r jedi-cli.js forward.js updater.js server.js auth.js js css bin samples types \
        index.html login.html account.html about.html ecosystem.config.js \
        "$pkgdir/usr/share/$pkgname/"

  install -Dm755 bin/jedi "$pkgdir/usr/bin/jedi"

  if [ -f packaging/apex-jedisyslogger.service ]; then
    install -Dm644 packaging/apex-jedisyslogger.service \
      "$pkgdir/usr/lib/systemd/system/apex-jedisyslogger.service"
  fi

  # `if`, not `[ -f x ] && cmd`: makepkg runs package() under `set -e`, and a
  # trailing test that fails is a failed build — which is exactly what a missing
  # LICENSE used to do here.
  for doc in README.md DOCUMENTATION.md CONNECTORS.md INSTALL.txt; do
    if [ -f "$doc" ]; then install -Dm644 "$doc" "$pkgdir/usr/share/doc/$pkgname/$doc"; fi
  done
  if [ -f LICENSE ]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
