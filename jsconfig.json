  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["js/**/*.js", "server.js", "auth.js", "forward.js", "jedi-cli.js", "packaging/bundle.js", "types/**/*.d.ts"]
}
